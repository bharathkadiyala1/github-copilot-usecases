# ============================================================
# Legacy Modernization Workbench - all settings live here.
# Edit values after the "=" sign. Lines starting with # are comments.
# A real environment variable with the same name overrides this file.
# ============================================================

# --- Which legacy system to work on ---
# python | sql | cobol | sas | ssis
LEGACY_SYSTEM=python

# --- Modern target ---
# csv     = plain Python pipeline only (always works)
# delta   = also generate a PySpark + Delta Lake job
# iceberg = also generate a PySpark + Iceberg job
TARGET=csv
# Run the generated PySpark job only if pyspark and Java are installed
RUN_SPARK=false
# Optional: path to a Delta/Iceberg jar if your Spark has no internet
SPARK_JARS=

# --- General ---
LOG_LEVEL=INFO
LOG_EVERY=100000

# --- Mock data (no real bank data is ever used) ---
MOCK_ROWS=500
MOCK_SEED=42

# --- Folders (relative to this project folder) ---
INPUT_FIXED=data/input/transactions.dat
INPUT_CSV=data/input/transactions.csv
OUTPUT_DIR=output
GOLDEN_DIR=golden
REPORT_DIR=reports
AUDIT_DIR=audit
GENERATED_DIR=generated

# --- Business rules (the modern pipeline reads these) ---
FX_USD_CAD=1.35
ATM_FEE_THRESHOLD=500.00
ATM_FEE=2.00
WIRE_FEE_RATE=0.001
WIRE_FEE_MIN=5.00
WIRE_FEE_MAX=25.00
CREDIT_TYPES=DEP,INT,XFRIN
DEBIT_TYPES=WDR,WIRE,POS,XFROUT
CURRENCIES=CAD,USD

# Each legacy system rounds differently (COBOL truncates, SSIS rounds half-even)
ROUNDING_BY_SYSTEM=python:ROUND_HALF_UP,sql:ROUND_HALF_UP,cobol:ROUND_DOWN,sas:ROUND_HALF_UP,ssis:ROUND_HALF_EVEN
# Leave blank. Set to ROUND_HALF_EVEN to watch the parity gate catch a mistake.
ROUNDING_OVERRIDE=

# --- Input formats ---
INPUT_FORMAT_BY_SYSTEM=python:fixed,sql:csv,cobol:fixed,sas:fixed,ssis:csv
DATE_FORMAT_FIXED=%Y%m%d
DATE_FORMAT_CSV=%Y-%m-%d

# --- GitHub Copilot ---
# Leave blank for "paste mode": the tool writes prompts to generated/prompts/ and you
# paste them into Copilot Chat, then save the reply into generated/copilot_answers/.
# Or put a command here. {prompt_file} is replaced by the prompt file path,
# {prompt} by the prompt text. With neither, the prompt is sent on stdin. Example:
#   COPILOT_CMD=your-copilot-command --some-flag {prompt_file}
COPILOT_CMD=
COPILOT_TIMEOUT=180
# Name written to the audit log as the human reviewer
REVIEWER=your.name
