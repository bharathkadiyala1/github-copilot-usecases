  "rules": [
    {
      "seq": "1",
      "type": "Driver",
      "name": "Base table",
      "left": "CORE_BANKING.CBS.DAILY_BALANCE (db)",
      "right": "-",
      "join_type": "-",
      "expr": "FROM CBS.DAILY_BALANCE db",
      "logic": "Driving table; grain = account + date",
      "applies": "M02,M06,M07,M08"
    },
    {
      "seq": "2",
      "type": "Join",
      "name": "Balance to Account",
      "left": "CBS.DAILY_BALANCE (db)",
      "right": "CBS.ACCOUNT (a)",
      "join_type": "INNER",
      "expr": "db.ACCT_ID = a.ACCT_ID",
      "logic": "Every balance row must belong to a valid account",
      "applies": "M01,M03,M04,M13,M14"
    },
    {
      "seq": "3",
      "type": "Join",
      "name": "Account to Branch",
      "left": "CBS.ACCOUNT (a)",
      "right": "CBS.BRANCH (b)",
      "join_type": "LEFT",
      "expr": "a.BRANCH_NO = b.BRANCH_NO",
      "logic": "Some digital accounts have no branch; keep them",
      "applies": "M05"
    },
    {
      "seq": "4",
      "type": "Join",
      "name": "FX rate",
      "left": "CBS.DAILY_BALANCE (db)",
      "right": "REF.FX_RATE (fx)",
      "join_type": "LEFT",
      "expr": "db.CURRENCY_CD = fx.FROM_CCY AND fx.TO_CCY = 'CAD' AND db.BAL_DATE = fx.RATE_DATE",
      "logic": "CAD rows need no rate (treated as 1.0); missing rates fall back to latest prior rate",
      "applies": "M06,M07,M09"
    },
    {
      "seq": "5",
      "type": "Join",
      "name": "Daily transaction summary",
      "left": "CBS.DAILY_BALANCE (db)",
      "right": "(SELECT ACCT_ID, TXN_DT, TXN_TYPE, SUM(TXN_AMT) amt, COUNT(DISTINCT TXN_ID) cnt FROM CBS.TXN WHERE TXN_STATUS='POSTED' GROUP BY ACCT_ID, TXN_DT, TXN_TYPE) (t)",
      "join_type": "LEFT",
      "expr": "db.ACCT_ID = t.ACCT_ID AND db.BAL_DATE = t.TXN_DT",
      "logic": "Aggregate before joining to avoid row fan-out; accounts without txns get 0",
      "applies": "M10,M11,M12"
    },
    {
      "seq": "6",
      "type": "Join",
      "name": "Customer dimension lookup",
      "left": "CBS.ACCOUNT (a)",
      "right": "DWH.DIM_CUSTOMER (c)",
      "join_type": "LEFT",
      "expr": "a.CUST_ID = c.CUST_ID AND c.CURRENT_FLAG = 'Y'",
      "logic": "Use current SCD2 version; unmatched \u2192 CUSTOMER_KEY = -1",
      "applies": "M03"
    },
    {
      "seq": "7",
      "type": "Join",
      "name": "Product dimension lookup",
      "left": "CBS.ACCOUNT (a)",
      "right": "DWH.DIM_PRODUCT (p)",
      "join_type": "LEFT",
      "expr": "a.PROD_CD = p.PROD_CD",
      "logic": "Unmatched \u2192 PRODUCT_KEY = -1",
      "applies": "M04"
    },
    {
      "seq": "8",
      "type": "Filter",
      "name": "Load window",
      "left": "db",
      "right": "-",
      "join_type": "-",
      "expr": "db.BAL_DATE >= :run_date - 3 AND db.BAL_DATE <= :run_date",
      "logic": "Incremental load with 3-day lookback for late-arriving data",
      "applies": "M02"
    },
    {
      "seq": "9",
      "type": "Filter",
      "name": "Exclude test accounts",
      "left": "a",
      "right": "-",
      "join_type": "-",
      "expr": "a.ACCT_TYPE <> 'TEST' AND a.ACCT_ID NOT IN (SELECT ACCT_ID FROM CBS.TEST_ACCOUNTS)",
      "logic": "Remove internal/test accounts",
      "applies": "All"
    },
    {
      "seq": "10",
      "type": "Filter",
      "name": "Exclude reversed/pending transactions",
      "left": "t",
      "right": "-",
      "join_type": "-",
      "expr": "TXN_STATUS = 'POSTED'",
      "logic": "Only posted transactions count toward debits/credits",
      "applies": "M10,M11,M12"
    },
    {
      "seq": "11",
      "type": "Filter",
      "name": "Valid currency only",
      "left": "db",
      "right": "-",
      "join_type": "-",
      "expr": "db.CURRENCY_CD IN (SELECT CCY_CD FROM REF.CURRENCY WHERE ACTIVE_FLAG='Y')",
      "logic": "Reject unknown currencies to the error table",
      "applies": "M06,M07,M08"
    },
    {
      "seq": "12",
      "type": "Filter",
      "name": "Non-null balance",
      "left": "db",
      "right": "-",
      "join_type": "-",
      "expr": "db.CLOSING_BAL IS NOT NULL",
      "logic": "Null balances are rejected and logged",
      "applies": "M06"
    },
    {
      "seq": "13",
      "type": "Dedup",
      "name": "Latest record per account/day",
      "left": "db",
      "right": "-",
      "join_type": "-",
      "expr": "ROW_NUMBER() OVER (PARTITION BY ACCT_ID, BAL_DATE ORDER BY LAST_UPD_TS DESC) = 1",
      "logic": "Keep the most recent version when source sends duplicates",
      "applies": "M01,M02"
    },
    {
      "seq": "14",
      "type": "Aggregation",
      "name": "Group by",
      "left": "-",
      "right": "-",
      "join_type": "-",
      "expr": "GROUP BY ACCT_ID, BAL_DATE (txn sub-query level)",
      "logic": "Target grain = one row per account per day",
      "applies": "All"
    },
    {
      "seq": "15",
      "type": "Target Load",
      "name": "Load strategy",
      "left": "-",
      "right": "-",
      "join_type": "-",
      "expr": "MERGE INTO DWH.FACT_ACCOUNT_DAILY ON (ACCOUNT_ID, BALANCE_DATE) \u2013 update if matched, insert if not",
      "logic": "Idempotent reruns",
      "applies": "All"
    }
  ],
  "reference_sql": "INSERT INTO DWH.FACT_ACCOUNT_DAILY\nSELECT a.ACCT_ID, db.BAL_DATE,\n       COALESCE(c.CUSTOMER_KEY,-1), COALESCE(p.PRODUCT_KEY,-1), COALESCE(br.BRANCH_KEY,-1),\n       CASE WHEN db.CURRENCY_CD='CAD' THEN db.CLOSING_BAL ELSE db.CLOSING_BAL*fx.RATE END,\n       CASE WHEN db.CURRENCY_CD='CAD' THEN db.AVAIL_BAL ELSE db.AVAIL_BAL*fx.RATE END,\n       UPPER(TRIM(db.CURRENCY_CD)), COALESCE(fx.RATE,1),\n       COALESCE(td.amt,0), COALESCE(tc.amt,0), COALESCE(td.cnt,0)+COALESCE(tc.cnt,0),\n       CASE a.STATUS_CD WHEN 'A' THEN 'ACTIVE' WHEN 'D' THEN 'DORMANT' WHEN 'C' THEN 'CLOSED' ELSE 'UNKNOWN' END,\n       DATEDIFF(day, a.OPEN_DT, db.BAL_DATE),\n       CASE WHEN db.CLOSING_BAL < 0 THEN 'Y' ELSE 'N' END,\n       CURRENT_TIMESTAMP, :batch_id\nFROM CBS.DAILY_BALANCE db\nJOIN CBS.ACCOUNT a ON db.ACCT_ID = a.ACCT_ID\nLEFT JOIN CBS.BRANCH br ON a.BRANCH_NO = br.BRANCH_NO\nLEFT JOIN REF.FX_RATE fx ON db.CURRENCY_CD = fx.FROM_CCY AND fx.TO_CCY='CAD' AND db.BAL_DATE = fx.RATE_DATE\nLEFT JOIN DWH.DIM_CUSTOMER c ON a.CUST_ID = c.CUST_ID AND c.CURRENT_FLAG='Y'\nLEFT JOIN DWH.DIM_PRODUCT p ON a.PROD_CD = p.PROD_CD\nLEFT JOIN txn_daily td ON db.ACCT_ID=td.ACCT_ID AND db.BAL_DATE=td.TXN_DT AND td.TXN_TYPE='D'\nLEFT JOIN txn_daily tc ON db.ACCT_ID=tc.ACCT_ID AND db.BAL_DATE=tc.TXN_DT AND tc.TXN_TYPE='C'\nWHERE db.BAL_DATE BETWEEN :run_date-3 AND :run_date\n  AND a.ACCT_TYPE <> 'TEST' AND db.CLOSING_BAL IS NOT NULL;",
  "filename": "Source_Target_Mapping_Example.xlsx"
}