# Copy this file to .env and edit. Every setting has a safe default.

# Web page address. 127.0.0.1 means "this computer only" (no one else can reach it).
HOST=127.0.0.1
PORT=8000

# Your name, pre-filled in the approval boxes.
REVIEWER=your name

# Command used to run scripts. Blank = the same Python that runs app.py.
PYTHON_CMD=

# Seconds a legacy/modern script may run before it is stopped.
RUN_TIMEOUT=60

# Compare settings (each job can override these in the page).
# KEY_COLUMNS: comma separated column(s) that identify a row, e.g. account_id. Blank = compare row by row.
KEY_COLUMNS=
# TOLERANCE: numbers that differ by no more than this count as equal. 0 = exact.
TOLERANCE=0
# MAX_MISMATCHES: how many differences to list on screen.
MAX_MISMATCHES=50

# Where the jobs live (one folder per migration).
JOBS_DIR=jobs

# What "modern" means for the Copilot prompt. The check always runs the Python job.
# Examples: python, aws_glue, azure_databricks, azure_data_factory, snowflake
MODERN_TARGET=python

# SQL flavour pre-selected on the Mapping to Code page (you can change it there).
# Examples: Snowflake SQL, PostgreSQL, Oracle SQL, SQL Server T-SQL, Teradata SQL, BigQuery SQL, Databricks SQL, ANSI SQL
SQL_DIALECT=Snowflake SQL

# Optional "Ask Copilot" button. Leave blank to use copy/paste (works everywhere).
# The prompt is sent to this command on stdin; the command prints the answer.
COPILOT_CMD=
